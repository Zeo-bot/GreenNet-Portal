APP_NAME=GreenNet
APP_TITLE=GreenNet Portal
APP_ENV=production
APP_VERSION=1.0.0
APP_COMMIT=
HTTP_PORT=8080
TZ=Asia/Damascus

DB_DRIVER=sqlite
DB_DATABASE=/var/www/database/database.sqlite
BACKUP_STORAGE_PATH=/var/www/storage/backups
BACKUP_RETENTION_COUNT=10

ADMIN_PATH=/admin
ADMIN_USERNAME=CHANGE_ME_ADMIN_USER
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

SUPPORT_PHONE=
SUPPORT_COUNTRY_CODE=
ACCESS_MODE=hybrid
AUTH_BACKEND=user-manager
CACHE_SECONDS=15

MIKROTIK_HOST=
MIKROTIK_API_PORT=8728
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=

QOS_ENABLED=false
QOS_MODE=smart
QOS_BACKEND=mikrotik

AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_SECONDS=300
AUTOMATION_RETRY_DELAY_SECONDS=900
AUTOMATION_STALE_LOCK_SECONDS=1800
