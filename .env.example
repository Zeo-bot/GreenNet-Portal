# Application
APP_NAME=GreenNetPortalLocal
APP_TITLE=GreenNet Portal Local
APP_ENV=development
APP_VERSION=0.0.0-local
TZ=UTC
HTTP_PORT=8080

# Public support placeholders
SUPPORT_PHONE=0000000000
SUPPORT_COUNTRY_CODE=000

# Access configuration
ACCESS_MODE=hybrid
AUTH_BACKEND=user-manager
CACHE_SECONDS=15

# Documentation-only RouterOS endpoint. Replace only in an authorized environment.
MIKROTIK_HOST=192.0.2.1
MIKROTIK_API_PORT=8728
MIKROTIK_USERNAME=CHANGE_ME_ROUTEROS_USER
MIKROTIK_PASSWORD=CHANGE_ME_ROUTEROS_PASSWORD

# Portal database
DB_DRIVER=sqlite
DB_DATABASE=/var/www/database/database.sqlite

# Administration
ADMIN_PATH=/admin
ADMIN_USERNAME=CHANGE_ME_ADMIN_USER
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# QoS
QOS_ENABLED=false
QOS_MODE=smart
QOS_BACKEND=mikrotik

# Scheduled operations
AUTOMATION_ENABLED=true
AUTOMATION_RETRY_DELAY_SECONDS=900
AUTOMATION_STALE_LOCK_SECONDS=1800
