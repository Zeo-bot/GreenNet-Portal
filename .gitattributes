# Default text handling; explicit rules below define repository line endings.
* text=auto

# Source and documentation use LF.
*.php text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.sh text eol=lf
*.svg text eol=lf

# Windows scripts use CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Images and operational databases are binary.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.sqlite binary
*.sqlite3 binary
*.db binary
*.sqlite-wal binary
*.sqlite-shm binary
*.sqlite-journal binary
