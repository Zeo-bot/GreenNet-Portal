APP_NAME=GreenNet
APP_TITLE=GreenNet Portal
APP_ENV=production
APP_VERSION=1.0.0
APP_COMMIT=
# Generic example only. The hAP ax3 RC1 package is authoritative and currently uses 172.31.255.2:8080.
APP_URL=http://172.30.30.2:8080
TZ=Asia/Damascus

DB_DRIVER=sqlite
DB_DATABASE=/greennet-data/database/database.sqlite
UPLOADS_STORAGE_PATH=/greennet-data/uploads
BACKUP_STORAGE_PATH=/greennet-data/backups
BACKUP_RETENTION_COUNT=5

ADMIN_PATH=/admin
ADMIN_USERNAME=CHANGE_ME_ADMIN_USER
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

SUPPORT_PHONE=
SUPPORT_COUNTRY_CODE=
ACCESS_MODE=hybrid
AUTH_BACKEND=user-manager
CACHE_SECONDS=15

# The host RouterOS API is normally its explicit veth gateway address, never localhost.
# The hAP ax3 RC1 package currently uses 172.31.255.1; do not copy this generic default into that deployment.
MIKROTIK_HOST=172.30.30.1
MIKROTIK_API_PORT=8728
MIKROTIK_USERNAME=CHANGE_ME_ROUTEROS_USER
MIKROTIK_PASSWORD=CHANGE_ME_ROUTEROS_PASSWORD

QOS_ENABLED=false
QOS_MODE=smart
QOS_BACKEND=mikrotik

AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_SECONDS=300
AUTOMATION_RETRY_DELAY_SECONDS=900
AUTOMATION_STALE_LOCK_SECONDS=1800
