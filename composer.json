{
    "name": "greennet/portal",
    "description": "GreenNet Portal test and development tooling",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "GreenNet\\": "src/app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GreenNet\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite unit"
    },
    "config": {
        "allow-plugins": {},
        "secure-http": true,
        "sort-packages": true
    }
}
